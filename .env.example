DB_HOST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority
PORT=3000
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
# Required in production for CORS + cross-site refresh cookie to work.
# Set to your deployed frontend's origin, e.g. https://my-frontend.vercel.app
FRONTEND_URL=
# Render (and most PaaS) set this automatically; set it yourself only for
# local production-mode testing. Enables secure/sameSite=none cookies + CORS lockdown.
NODE_ENV=development
