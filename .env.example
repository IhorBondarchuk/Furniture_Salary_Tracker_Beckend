DB_HOST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority
PORT=3000
# The single account allowed to sign in (POST /api/auth/login).
APP_LOGIN=
APP_PASSWORD=
# Long random string used to sign login tokens (valid 30 days).
# Changing it signs everyone out.
JWT_SECRET=
# Optional: restrict browser access (CORS) to your deployed frontend's origin,
# e.g. https://my-frontend.vercel.app. Empty — any origin is allowed.
FRONTEND_URL=
