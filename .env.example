DB_HOST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority
PORT=3000
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
# Secret code for registering with role=admin. Leave empty to disable
# admin self-registration (admins then only via `npm run set-role`).
ADMIN_INVITE_CODE=
# Required in production for CORS + cross-site refresh cookie to work.
# Set to your deployed frontend's origin, e.g. https://my-frontend.vercel.app
FRONTEND_URL=
# Set to `production` explicitly in the Render dashboard (don't rely on the
# platform to set it). Enables secure/sameSite=none cookies; with it the server
# refuses to start unless FRONTEND_URL is set.
NODE_ENV=development
